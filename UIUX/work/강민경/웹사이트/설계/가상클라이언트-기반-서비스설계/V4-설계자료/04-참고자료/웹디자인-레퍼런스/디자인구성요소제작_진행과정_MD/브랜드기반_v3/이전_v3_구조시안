<!doctype html>
<html lang="ko"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>DAMORI Final Style Guide</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;600;700&family=Noto+Serif+KR:wght@400;600;700&display=swap');
:root{--ink:#20231d;--olive:#4f603f;--sage:#b8c5a9;--cream:#f7f2e9;--paper:#fffdf8;--line:#d8d2c7;--muted:#77776f;--clay:#b96249;--focus:#2457a7;--ok:#759568;--warn:#e2b43f;--danger:#df4f42}
*{box-sizing:border-box}html,body{margin:0;width:1586px;height:992px;overflow:hidden;background:var(--cream);color:var(--ink);font-family:'Noto Sans KR','Malgun Gothic',sans-serif}.page{width:1586px;height:992px;padding:48px 54px;background:radial-gradient(circle at 80% 10%,rgba(184,197,169,.13),transparent 28%),linear-gradient(90deg,rgba(79,96,63,.055) 1px,transparent 1px),var(--paper);background-size:auto,132px 100%,auto;position:relative}.page.dark{background:linear-gradient(rgba(20,24,18,.96),rgba(20,24,18,.96)),var(--ink);color:#f7f2e9}.top{display:flex;align-items:center;gap:28px;margin-bottom:28px}.no{font:600 16px 'Noto Serif KR';letter-spacing:2px;color:var(--olive)}.dark .no{color:var(--sage)}.eyebrow{font-size:14px;letter-spacing:2.5px;text-transform:uppercase;color:var(--olive)}.dark .eyebrow{color:var(--sage)}h1{font:600 48px/1.16 'Noto Serif KR';margin:0 0 14px;letter-spacing:-1.5px}h2{font:600 20px 'Noto Serif KR';margin:0 0 14px}h3{font-size:13px;letter-spacing:1.2px;color:var(--olive);margin:0 0 12px;text-transform:uppercase}.desc{font-size:16px;color:var(--muted);margin:0 0 26px}.dark .desc{color:#c9c9bf}.rule{height:1px;background:var(--olive);opacity:.7;margin:18px 0 28px}.grid{display:grid;gap:18px}.g2{grid-template-columns:repeat(2,1fr)}.g3{grid-template-columns:repeat(3,1fr)}.g4{grid-template-columns:repeat(4,1fr)}.g5{grid-template-columns:repeat(5,1fr)}.card{border:1px solid var(--line);border-radius:14px;background:rgba(255,253,248,.88);padding:22px}.dark .card{background:rgba(255,255,255,.05);border-color:rgba(255,255,255,.15)}.label{font-size:12px;letter-spacing:1.1px;color:var(--olive);font-weight:700;text-transform:uppercase}.value{font:600 26px 'Noto Serif KR';margin:8px 0}.small{font-size:13px;color:var(--muted);line-height:1.65}.dark .small{color:#b9b9b0}.pill{display:inline-flex;align-items:center;justify-content:center;border-radius:999px;padding:10px 18px;background:var(--olive);color:white;font-size:13px}.outline{background:transparent;color:var(--olive);border:1px solid var(--olive)}.ghost{background:#eef0e8;color:var(--olive)}.swatch{height:112px;border-radius:12px;margin-bottom:13px;border:1px solid rgba(0,0,0,.08)}.line-demo{display:flex;align-items:center;gap:14px;margin:13px 0}.dot{width:14px;height:14px;border-radius:50%;background:var(--olive)}.side-title{display:grid;grid-template-columns:280px 1fr;gap:34px}.aside{border-right:1px solid var(--line);padding-right:30px}.main{min-width:0}.quote{font:600 30px/1.5 'Noto Serif KR';letter-spacing:-.5px}.mock{border:1px solid var(--line);border-radius:18px;overflow:hidden;background:var(--paper)}.mockhead{height:64px;background:linear-gradient(135deg,#667056,#30372d);position:relative;padding:14px 18px;color:white}.capsule{position:absolute;left:50%;transform:translateX(-50%);top:12px;padding:10px 28px;background:rgba(30,32,27,.52);backdrop-filter:blur(12px);border:1px solid rgba(255,255,255,.16);border-radius:999px;font-size:11px;word-spacing:20px;white-space:nowrap}.mockbody{padding:22px}.bar{height:8px;border-radius:9px;background:#e6e2d9;margin:8px 0}.bar.on{background:var(--olive)}.tag{display:inline-block;padding:5px 9px;border-radius:99px;background:#ecede6;font-size:11px;color:var(--olive);margin:3px}.device{border:8px solid #252722;border-radius:20px;background:white;padding:14px;box-shadow:0 18px 35px rgba(32,35,29,.18)}.diary{background:#aeb99d;border-radius:22px;padding:18px;box-shadow:0 20px 42px rgba(54,63,45,.22);transform:rotate(-4deg)}.paper{background:#fffdf7;border-radius:7px;padding:22px;min-height:240px;box-shadow:0 10px 20px rgba(0,0,0,.09)}.paper .bar{height:2px;margin:22px 0;background:#d9d1c5}.step{display:flex;align-items:center;gap:10px}.step i{width:34px;height:34px;border:1px solid var(--olive);border-radius:50%;display:grid;place-items:center;font-style:normal}.step:after{content:'';height:1px;background:var(--line);flex:1}.step:last-child:after{display:none}.footer{position:absolute;left:54px;right:54px;bottom:32px;display:flex;justify-content:space-between;border-top:1px solid var(--line);padding-top:12px;font-size:11px;color:var(--muted)}.check{display:flex;gap:10px;align-items:flex-start;margin:10px 0;font-size:14px;line-height:1.45}.check:before{content:'✓';color:var(--olive);font-weight:700}.alert{padding:14px;border-left:3px solid var(--clay);background:#f4e8e2;font-size:13px}.hero-scene{height:580px;border-radius:26px;background:linear-gradient(135deg,#d6d4c7,#ece8de);position:relative;overflow:hidden}.hero-scene:before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 65% 40%,rgba(255,255,255,.7),transparent 30%)}.floating{position:absolute;background:rgba(255,253,248,.92);border:1px solid rgba(255,255,255,.7);box-shadow:0 18px 45px rgba(33,39,29,.12);border-radius:18px}.cut{border-radius:42% 58% 61% 39%/40% 38% 62% 60%;overflow:hidden;background:#d6dccd}.mini-page{height:410px;background:#f8f5ed;border:1px solid var(--line);border-radius:15px;padding:14px}.screenrow{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.screen{border:1px solid var(--line);border-radius:12px;padding:13px;background:white;height:126px}.focus{outline:3px solid var(--focus);outline-offset:3px}.status{display:flex;gap:7px;align-items:center}.status b{width:10px;height:10px;border-radius:50%;display:block}.note{font:400 17px/1.8 'Noto Serif KR';word-break:keep-all}.kicker{font:600 13px 'Noto Sans KR';color:var(--olive);letter-spacing:1px}.template{height:160px;border-radius:14px;padding:16px;background:#ede8dd;position:relative;overflow:hidden}.template:after{content:'';position:absolute;width:90px;height:120px;background:#fffdf7;right:18px;top:18px;box-shadow:0 6px 14px rgba(0,0,0,.09);transform:rotate(3deg)}
</style>
<style>
h1{font-size:42px}
.side-title .aside h1{font-size:38px;line-height:1.12;overflow-wrap:anywhere}
</style></head><body><div id="app"></div>
<script>
const P=(n,title,sub,body,dark=false)=>`<section class="page ${dark?'dark':''}"><div class="top"><span class="no">${String(n).padStart(2,'0')} / 13</span><span class="eyebrow">DAMORI · FINAL DESIGN SYSTEM</span></div>${body}<div class="footer"><span>기록은 남고, 방식은 달라져도 돼요.</span><span>FINAL · v3 · 2026</span></div></section>`;
const pages=[];
pages.push(P(1,'','',`<div style="display:grid;grid-template-columns:1.15fr .85fr;gap:70px;align-items:center;height:780px"><div><div class="eyebrow">CALM EDITORIAL UTILITY</div><h1 style="font-size:112px;margin:35px 0 5px">DAMORI</h1><div class="quote">다모리 기록 라이프스타일</div><div class="rule" style="width:520px"></div><p class="desc">종이의 감각과 디지털의 편리함을 하나의 기준으로 연결합니다.</p><div style="display:flex;gap:12px"><span class="pill">BRAND / EDITORIAL</span><span class="pill ghost">FUNCTIONAL UI</span></div><p class="small" style="margin-top:45px">기록 자율성 · 작은 시작 · 부담 없는 복귀 · 원본 보호 · 실물 연결</p></div><div class="diary" style="width:470px"><div class="paper" style="height:530px"><div class="kicker">ONE LINE TODAY</div><div class="bar"></div><div class="bar"></div><div class="bar"></div><div class="bar"></div><div style="margin-top:90px;font:600 46px 'Noto Serif KR';color:var(--olive)">A / D</div></div></div></div>`,true));
pages.push(P(2,'','',`<div class="side-title"><aside class="aside"><h1>PRINCIPLES<br>& IA</h1><div class="rule"></div><div class="check">한 줄로 가볍게 시작</div><div class="check">작업으로 즉시 복귀</div><div class="check">기록 방식은 자유롭게</div><div class="check">기능 상태는 정직하게</div></aside><main class="main"><h3>Brand promise</h3><div class="quote">기록은 남고,<br>방식은 달라져도 돼요.</div><p class="desc">문장은 의미 단위로 묶고 조사·어미만 다음 줄에 남지 않게 합니다.</p><div class="grid g4"><div class="card"><span class="label">01 Discover</span><div class="value">방식 보기</div><p class="small">아날로그와 디지털 기록의 차이를 장면으로 이해</p></div><div class="card"><span class="label">02 Choose</span><div class="value">템플릿 고르기</div><p class="small">여행·학습·취향·회고 목적별 빠른 탐색</p></div><div class="card"><span class="label">03 Make</span><div class="value">조금 바꾸기</div><p class="small">내용·색상·표지만 간단히 조정</p></div><div class="card"><span class="label">04 Continue</span><div class="value">이어가기</div><p class="small">로그인 또는 로컬 작업으로 즉시 복귀</p></div></div><h3 style="margin-top:28px">Information architecture</h3><div class="grid g5"><div class="card">HOME</div><div class="card">RECORD</div><div class="card">TEMPLATE</div><div class="card">MAKER</div><div class="card">MY RECORD</div></div><div class="alert" style="margin-top:22px">Planned 기능은 로그인·동기화·주문 제작을 완료 기능처럼 표현하지 않습니다.</div></main></div>`));
pages.push(P(3,'','',`<h1>FOUNDATIONS · COLOR</h1><p class="desc">기존 Cream·Olive·Brown을 유지하고 기능 상태색은 제한적으로 사용합니다.</p><div class="grid g5"><div><div class="swatch" style="background:#20231d"></div><b>INK</b><p class="small">#20231D<br>제목·본문</p></div><div><div class="swatch" style="background:#4f603f"></div><b>OLIVE</b><p class="small">#4F603F<br>Primary·Brand</p></div><div><div class="swatch" style="background:#b8c5a9"></div><b>SAGE</b><p class="small">#B8C5A9<br>Subtle Accent</p></div><div><div class="swatch" style="background:#f7f2e9"></div><b>CREAM</b><p class="small">#F7F2E9<br>Canvas</p></div><div><div class="swatch" style="background:#fffdf8"></div><b>PAPER</b><p class="small">#FFFDF8<br>Surface</p></div></div><div class="rule"></div><div class="grid g4"><div class="card"><div class="status"><b style="background:#759568"></b><strong>완료</strong></div><p class="small">#759568 · Success</p></div><div class="card"><div class="status"><b style="background:#e2b43f"></b><strong>진행 중</strong></div><p class="small">#E2B43F · Warning</p></div><div class="card"><div class="status"><b style="background:#df4f42"></b><strong>주의 필요</strong></div><p class="small">#DF4F42 · Error</p></div><div class="card focus"><div class="status"><b style="background:#2457a7"></b><strong>키보드 포커스</strong></div><p class="small">#2457A7 · 3:1+</p></div></div><div class="grid g2" style="margin-top:24px"><div class="card"><h3>Use</h3><p class="note">색은 정보의 우선순위와 상태를 설명합니다. Olive는 행동, Sage는 배경, Brown은 촉각적 강조에 사용합니다.</p></div><div class="card"><h3>Avoid</h3><p class="note">레퍼런스의 원색을 그대로 가져오지 않습니다. 한 화면의 강한 색은 브랜드색 1개와 상태색 1개로 제한합니다.</p></div></div>`));
pages.push(P(4,'','',`<div class="side-title"><aside class="aside"><h1>TYPOGRAPHY<br>& WRAP</h1><div class="rule"></div><p class="small">Display · Noto Serif KR<br>UI · Noto Sans KR</p><div class="value">48 / 56</div><div class="small">Hero Display</div><div class="value">32 / 44</div><div class="small">Section Title</div><div class="value">16 / 28</div><div class="small">Body</div></aside><main><h3>Meaning-first line breaks</h3><div class="grid g2"><div class="card"><span class="label">Preferred</span><div class="quote" style="margin-top:18px">기록은 남고,<br>방식은 달라져도 돼요.</div><div class="check">의미 단위가 온전함</div></div><div class="card" style="opacity:.62"><span class="label" style="color:var(--danger)">Avoid</span><div class="quote" style="margin-top:18px">기록은 남고, 방식은 달라져도 돼<br>요.</div><div class="alert">조사·어미 한 글자만 다음 줄에 남음</div></div></div><div class="rule"></div><div class="grid g3"><div><h3>Desktop</h3><p class="note">제목 최대 16자 권장<br>본문 48~66자 폭</p></div><div><h3>Tablet</h3><p class="note">수동 줄바꿈 최소화<br><code>&lt;span&gt;</code> 의미 묶음 유지</p></div><div><h3>Mobile</h3><p class="note">32px Display 상한<br><code>word-break: keep-all</code></p></div></div><div class="card" style="margin-top:34px"><b>검수 문장</b><p class="note">종이와 화면을 같은 기준으로 비교해요. · 한 줄만 남겨도 기록은 시작됩니다. · 지금 이어서 작성할 수 있어요.</p></div></main></div>`));
pages.push(P(5,'','',`<h1>FOUNDATIONS · GRID & SPACING</h1><p class="desc">1586×992 보드와 1440px Web 기준. 밀도보다 읽는 순서가 먼저입니다.</p><div class="grid" style="grid-template-columns:1.2fr .8fr"><div class="card"><h3>12 Column Web Grid</h3><div style="display:grid;grid-template-columns:repeat(12,1fr);gap:10px;height:270px">${Array(12).fill('<div style="background:rgba(79,96,63,.16);border:1px solid rgba(79,96,63,.28);border-radius:6px"></div>').join('')}</div><p class="small">Margin 64 · Gutter 24 · Content max 1312</p></div><div class="card"><h3>Spacing scale</h3>${[4,8,12,16,24,32,48,64,96].map(x=>`<div class="line-demo"><span style="width:34px">${x}</span><i style="display:block;height:12px;width:${x*2.2}px;background:var(--olive);border-radius:3px"></i></div>`).join('')}</div></div><div class="grid g3" style="margin-top:20px"><div class="card"><b>기능 카드</b><p class="small">내부 20~24 · 카드 간 16~24</p></div><div class="card"><b>편집 섹션</b><p class="small">상하 96~144 · 큰 여백 허용</p></div><div class="card"><b>Mobile</b><p class="small">좌우 20 · Section 72 · Gap 16</p></div></div>`));
pages.push(P(6,'','',`<h1>RADIUS · EFFECTS · TEXTURE</h1><div class="grid g4"><div class="card"><h3>Control</h3><div style="height:70px;border:1px solid var(--olive);border-radius:8px"></div><p class="small">8–12px</p></div><div class="card"><h3>Functional card</h3><div style="height:70px;border:1px solid var(--olive);border-radius:16px"></div><p class="small">12–16px</p></div><div class="card"><h3>Editorial image</h3><div class="cut" style="height:70px"></div><p class="small">16px 또는 Organic crop</p></div><div class="card"><h3>Menu capsule</h3><div class="pill" style="width:100%">중앙 메뉴 전용</div><p class="small">999px</p></div></div><div class="rule"></div><div class="grid g3"><div class="card"><h3>Border before shadow</h3><div class="card" style="height:120px">기본 Surface</div><p class="small">먼저 1px Border로 층위 표현</p></div><div class="card"><h3>Shadow</h3><div class="card" style="height:120px;box-shadow:0 18px 35px rgba(32,35,29,.14)">Diary · Device · Floating only</div><p class="small">장면 속 부유 요소에만 제한</p></div><div class="card"><h3>Paper texture</h3><div style="height:120px;background:repeating-linear-gradient(35deg,#f6f1e8,#f6f1e8 3px,#eee9df 4px);border-radius:12px"></div><p class="small">2–4% · Hero/About only</p></div></div><div class="alert" style="margin-top:24px">모든 카드에 그림자를 넣지 않습니다. 기능 영역은 명확하고 평평하게, 브랜드 장면만 촉각적으로 표현합니다.</div>`));
pages.push(P(7,'','',`<h1>COMPONENTS · ACTION & STATUS</h1><div class="grid g3"><div class="card"><h3>Primary</h3><button class="pill" style="border:0;width:100%">기록 시작하기 →</button><p class="small">최우선 행동 · Olive fill</p></div><div class="card"><h3>Secondary</h3><button class="pill outline" style="width:100%">템플릿 둘러보기</button><p class="small">보조 행동 · Outline</p></div><div class="card"><h3>Tertiary</h3><button style="border:0;background:none;color:var(--olive);padding:10px">나중에 하기 →</button><p class="small">낮은 우선순위 · Text</p></div></div><div class="rule"></div><div class="grid g4"><div class="card"><span class="tag">여행 기록</span><span class="tag">학습</span><span class="tag">취향 수집</span><p class="small">Filter chip</p></div><div class="card"><div class="status"><b style="background:var(--ok)"></b>저장됨</div><p class="small">완료 상태</p></div><div class="card"><div class="status"><b style="background:var(--warn)"></b>저장 중</div><p class="small">진행 상태</p></div><div class="card"><div class="status"><b style="background:var(--danger)"></b>연결 확인</div><p class="small">오류 상태</p></div></div><div class="grid g2" style="margin-top:22px"><div class="card focus"><b>Keyboard Focus</b><p class="small">3px Blue outline · 3:1 이상 · 색만으로 상태를 구분하지 않음</p></div><div class="card" style="opacity:.48"><b>Disabled</b><p class="small">비활성 이유를 인접 문구로 설명</p></div></div>`));
pages.push(P(8,'','',`<h1>TRANSPARENT OVERLAY HEADER</h1><p class="desc">전체 Header가 아니라 중앙 메뉴만 Capsule입니다.</p><div class="mock" style="height:500px"><div class="mockhead" style="height:500px;background:linear-gradient(rgba(30,32,27,.26),rgba(30,32,27,.22)),linear-gradient(135deg,#6f735f,#c2b49e)"><b style="font:600 23px 'Noto Serif KR'">DAMORI</b><div class="capsule">기록 방식 템플릿 만들기 이야기</div><span style="position:absolute;right:24px;top:20px;font-size:12px">검색　로그인　KR</span><div style="position:absolute;left:70px;bottom:70px"><div class="quote" style="font-size:46px">기록을 펼치고,<br>나에게 맞게 이어가요.</div><p>쿠션 다이어리에서 디지털 기록까지</p></div></div></div><div class="grid g4" style="margin-top:20px"><div class="card"><h3>Logo</h3><p class="small">Hero 위 직접 배치</p></div><div class="card"><h3>Center menu</h3><p class="small">반투명 Capsule + Blur</p></div><div class="card"><h3>Utility</h3><p class="small">검색·로그인 직접 배치</p></div><div class="card"><h3>Mobile</h3><p class="small">Logo + Menu button으로 축약</p></div></div>`));
