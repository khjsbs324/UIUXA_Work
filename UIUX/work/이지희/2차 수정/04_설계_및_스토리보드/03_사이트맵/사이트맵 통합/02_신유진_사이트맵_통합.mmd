graph TD
    classDef root fill:#0D47A1,stroke:#01579B,stroke-width:2px,color:#FFFFFF,font-weight:bold;
    classDef gnb fill:#1A237E,stroke:#0D47A1,stroke-width:2px,color:#FFFFFF,font-weight:bold;
    classDef lnb fill:#E8F5E9,stroke:#2E7D32,stroke-width:1.5px,color:#1B5E20,font-weight:bold;
    classDef detail fill:#FFF8E1,stroke:#F57F17,stroke-width:1.5px,color:#E65100;
    classDef aside fill:#E1F5FE,stroke:#0277BD,stroke-width:1.5px,color:#01579B;

    ROOT["🏠 W02-HOME (믹솔로지 랩 허브)<br/>• 3D 쉐이커 캔버스<br/>• 5대 목적 퀵독"]

    GNB1["🍹 GNB-01: 레시피 랩<br/>(W02-RECIPE)"]
    GNB2["🎛️ GNB-02: 후각 스튜디오<br/>(W02-STUDIO)"]
    GNB3["🛠️ GNB-03: 스타터 빌더<br/>(W02-BUILD)"]
    GNB4["🧮 GNB-04: 벌크 계산기<br/>(W02-ESTIMATE)"]
    GNB5["🎬 GNB-05: 챌린지 룸<br/>(W02-COMM)"]

    ROOT --> GNB1
    ROOT --> GNB2
    ROOT --> GNB3
    ROOT --> GNB4
    ROOT --> GNB5

    %% GNB1
    LNB11["🍹 0.1초 융해 에이드"]
    LNB12["🌙 나이트 아로마"]
    GNB1 --> LNB11
    GNB1 --> LNB12

    %% GNB2
    DIAL["🎛️ 8대 향미 슬라이더"]
    FORMULA["🧪 0.1g 조향 등록증"]
    GNB2 --> DIAL
    GNB2 --> FORMULA

    %% GNB3
    ENGRAVE["⚡ 3D 지거/틴 각인기"]
    GIFT["🎁 카카오 선물 뷰어"]
    GNB3 --> ENGRAVE
    GNB3 --> GIFT

    %% GNB4
    CALC["🧮 60포 벌크 비율"]
    BUNDLE["🍸 바텐더 툴 20%"]
    GNB4 --> CALC
    GNB4 --> BUNDLE

    %% GNB5
    FEED["🎬 15초 릴스 피드"]
    VOTE["🏆 실시간 투표 랭킹"]
    GNB5 --> FEED
    GNB5 --> VOTE

    DRAWER["🛒 Aside: W02-DRAWER<br/>• 3초 패스트 체크아웃 / 새벽배송"]
    ROOT -.-> DRAWER

    class ROOT root;
    class GNB1,GNB2,GNB3,GNB4,GNB5 gnb;
    class LNB11,LNB12 lnb;
    class DIAL,FORMULA,ENGRAVE,GIFT,CALC,BUNDLE,FEED,VOTE detail;
    class DRAWER aside;