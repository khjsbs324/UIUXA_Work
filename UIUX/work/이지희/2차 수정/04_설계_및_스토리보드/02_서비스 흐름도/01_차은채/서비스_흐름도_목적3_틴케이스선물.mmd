    HOME --> COLLECT
    COLLECT --> BUILD
    BUILD --> WRAP
    WRAP --> DRAWER
    DRAWER --> ADDR_CHECK
    
    ADDR_CHECK -->|주소 입력 완료| DONE
    ADDR_CHECK -->|주소 미입력 링크 전송| DONE
    
    DONE --> COMM

    class HOME home;
    class COLLECT explore;
    class BUILD,WRAP atelier;
