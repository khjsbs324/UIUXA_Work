flowchart TD
    classDef home fill:#1A237E,stroke:#0D47A1,stroke-width:2px,color:#FFFFFF,font-weight:bold;
    classDef diag fill:#FFF8E1,stroke:#F57F17,stroke-width:2px,color:#E65100,font-weight:bold;
    classDef mix fill:#E8F5E9,stroke:#2E7D32,stroke-width:1.5px,color:#1B5E20,font-weight:bold;
    classDef decision fill:#FFF9C4,stroke:#FBC02D,stroke-width:2px,color:#F57F17,font-weight:bold;
    classDef transact fill:#E1F5FE,stroke:#0277BD,stroke-width:2px,color:#01579B,font-weight:bold;
    classDef support fill:#37474F,stroke:#263238,stroke-width:1.5px,color:#FFFFFF;

    HOME["01 W01-HOME (긴급 진입)<br/>• [3초 감정 진단] 퀵독 클릭"]
    DIAG["02 W01-DIAG (3축 진단 콘솔)<br/>• DIAGNOSTIC-DIAL-01<br/>• [번아웃/수면/카페인] 슬라이더<br/>• 1:1 맞춤 티 3안 처방"]
    MIX["03 W01-MIX (1초 융해 & 성적서)<br/>• 찬물 1초 융해 3D 모션<br/>• KTR 공인 0kcal 성적서"]
    DRAWER["05 W01-DRAWER (구독 드로어)<br/>• FAST-SUBSCRIPTION-01<br/>• 15% 정기할인 & 30일 배송"]
    
    PAY_CHECK{"06 정기결제<br/>승인 여부"}
    
    DONE["07 W01-DONE (구독 승인)<br/>• 구독 코드 발급 & 알림톡 발송<br/>• 진단 위치 100% 스크롤 복원"]
    RETRY["06-B 대체 결제 (Fallback)<br/>• 카카오페이/토스페이 전환"]
    COMM["F1 W01-COMM (월간 케어)<br/>• 월간 감정 변화 트래킹<br/>• 다음달 티 스왑 관리"]

    HOME --> DIAG
    DIAG --> MIX
    MIX --> DRAWER
    DRAWER --> PAY_CHECK
    
    PAY_CHECK -->|결제 성공| DONE
    PAY_CHECK -->|한도초과/실패| RETRY
    RETRY -.->|결제 수단 변경 후| DRAWER
    
    DONE --> COMM
    DONE -.->|가상 스크롤 100% 복원| DIAG

    class HOME home;
    class DIAG diag;
    class MIX mix;
    class PAY_CHECK decision;
    class DRAWER,DONE,RETRY transact;
    class COMM support;