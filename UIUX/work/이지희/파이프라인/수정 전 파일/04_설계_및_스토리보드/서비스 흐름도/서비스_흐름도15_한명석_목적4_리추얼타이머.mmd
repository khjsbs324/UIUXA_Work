flowchart TD
    classDef main fill:#0B132B,stroke:#1E293B,stroke-width:2px,color:#0F172A,font-weight:bold;
    classDef track fill:#F8FAFC,stroke:#1E293B,stroke-width:1.5px,color:#0F172A,font-weight:bold;
    classDef action fill:#FFFFFF,stroke:#334155,stroke-width:1px,color:#0F172A;
    classDef drawer fill:#EFF6FF,stroke:#2563EB,stroke-width:2px,color:#1E40AF,font-weight:bold;

    Start(["🚀 진입: WICKETA 한명석 (목적 4 [리추얼/타이머 모드])"])
    Hero["PG-01: Hero Section<br>⭐ 1순위 킬러: 150% Big Font 캄테크 UX & 항산화 안식처"]
    
    Start --> Hero

    subgraph T1["180초 수색 변환 순환 루프"]
        N1["PG-02: 인터랙티브 스위처"]
        N2{"REQ-01: 3D 모션 실행?"}
        N3["1.0초 수색 Canvas 렌더링"]
        N1 --> N2
        N2 -- YES --> N3
    end

    subgraph T2["Quick Order Drawer 트랙"]
        N4["PG-03: 180초 타이머"]
        N5["REQ-03: 앰비언트 Sound 재생"]
        N4 --> N5
    end

    subgraph T3["마이 힐링 사운드 보관 트랙"]
        N6["PG-31: 3D 이니셜 각인"]
        N7["PG-04: 3초 Cart Drawer (Aside)"]
        N8["REQ-05: 1-Click Fast Checkout"]
        N6 --> N7 --> N8
    end

    Hero --> T1
    T1 --> T2
    T2 --> T3

    End(["🏁 완료: 결제 완료 & 스크롤 위치 100% 복원"])
    T3 --> End

    class Start,End main;
    class Hero,N1,N4,N6 track;
    class N2,N3,N5 action;
    class N7,N8 drawer;
