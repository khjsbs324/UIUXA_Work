flowchart TD
    classDef main fill:#2B0548,stroke:#7C3AED,stroke-width:2px,color:#0F172A,font-weight:bold;
    classDef track fill:#F8FAFC,stroke:#7C3AED,stroke-width:1.5px,color:#0F172A,font-weight:bold;
    classDef action fill:#FFFFFF,stroke:#334155,stroke-width:1px,color:#0F172A;
    classDef drawer fill:#EFF6FF,stroke:#2563EB,stroke-width:2px,color:#1E40AF,font-weight:bold;

    Start(["🚀 진입: WICKETA 서지안 (목적 5 [재방문/소셜 모드])"])
