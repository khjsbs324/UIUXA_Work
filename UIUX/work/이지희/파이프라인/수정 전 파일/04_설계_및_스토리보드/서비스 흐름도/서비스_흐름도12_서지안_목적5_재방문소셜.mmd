        N5["REQ-03: 앰비언트 Sound 재생"]
        N4 --> N5
    end

    subgraph T3["카카오 커뮤니티 초대 트랙"]
        N6["PG-31: 3D 이니셜 각인"]
        N7["PG-04: 3초 Cart Drawer (Aside)"]
        N8["REQ-05: 1-Click Fast Checkout"]
        N6 --> N7 --> N8
