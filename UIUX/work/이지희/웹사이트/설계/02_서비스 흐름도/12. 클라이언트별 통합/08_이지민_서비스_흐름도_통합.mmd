flowchart TD
    classDef home fill:#1A237E,stroke:#0D47A1,stroke-width:2px,color:#FFFFFF,font-weight:bold;
    classDef explore fill:#E8F5E9,stroke:#2E7D32,stroke-width:1.5px,color:#1B5E20,font-weight:bold;
    classDef atelier fill:#FFF8E1,stroke:#F57F17,stroke-width:2px,color:#E65100,font-weight:bold;
    classDef action fill:#E1F5FE,stroke:#0277BD,stroke-width:2px,color:#01579B,font-weight:bold;
    classDef support fill:#37474F,stroke:#263238,stroke-width:1.5px,color:#FFFFFF;

    subgraph HUB ["HUB: WICKETA 이지민 감성 홈카페 메인 허브"]
        HOME["01 W08-HOME (홈카페 메인)<br/>• 3D 오로라 수색 변환 캔버스<br/>• COLOR-SHIFT-01 퀵독<br/>• 학생증 20% 할인 배너"]
    end

    subgraph PATH1 ["경로 1: 수색 변환 에이드 & 글래스 구매"]
        COLOR["02-A W08-COLOR<br/>수색 변환 시뮬레이터<br/>• 블루➔퍼플➔핑크 모션"]
    end

    subgraph PATH2 ["경로 2: 20% 학생 할인 홈카페 정기구독"]
        SUB["02-B W08-SUB<br/>STUDENT-SUB-01 콘솔<br/>• 학생증 인증 & 20% 할인"]
    end

